import React, { useEffect, useState, useRef } from "react";
import { io } from "socket.io-client";

// -----------------------------
// 2️⃣ Socket initialization
// (we'll connect after user enters a name)
// -----------------------------
const SOCKET_SERVER_URL = "http://localhost:5000";

function App() {
  // -----------------------------
  // 3️⃣ Local component state
  // -----------------------------
  const [connected, setConnected] = useState(false);
  const [username, setUsername] = useState("");
  const [nameSubmitted, setNameSubmitted] = useState(false);

  const [messageInput, setMessageInput] = useState("");
  const [messages, setMessages] = useState([]);

  const socketRef = useRef(null);
  const messagesEndRef = useRef(null);

  // -----------------------------
  // 4️⃣ Scroll to latest message helper
  // -----------------------------
  const scrollToBottom = () => {
    if (messagesEndRef.current) {
      messagesEndRef.current.scrollIntoView({ behavior: "smooth" });
    }
  };

  useEffect(scrollToBottom, [messages]);

  // -----------------------------
  // 5️⃣ Connect to socket only once when name is submitted
  // -----------------------------
  const handleJoin = () => {
    if (!username.trim()) return;
    // connect to server
    const socket = io(SOCKET_SERVER_URL, { transports: ["websocket"] });

    socketRef.current = socket;

    // on initial connection
    socket.on("connect", () => {
      setConnected(true);
      // tell server our username
      socket.emit("join", username);
    });

    // listen for incoming messages
    socket.on("message", (message) => {
      // message => { user, text, time }
      setMessages((prev) => [...prev, message]);
    });

    // on disconnect
    socket.on("disconnect", () => {
      setConnected(false);
    });

    setNameSubmitted(true);
  };

  // -----------------------------
  // 6️⃣ Send message to server
  // -----------------------------
  const sendMessage = (e) => {
    e.preventDefault();
    const text = messageInput.trim();
    if (!text || !socketRef.current) return;

    // emit to server with optional callback to confirm
    socketRef.current.emit("sendMessage", text, (status) => {
      // optional: show delivered status in console or UI
      // console.log("Server ack:", status);
    });

    setMessageInput("");
  };

  // -----------------------------
  // 7️⃣ Simple timestamp formatter
  // -----------------------------
  const formatTime = (isoStr) => {
    try {
      const d = new Date(isoStr);
      return d.toLocaleTimeString();
    } catch {
      return "";
    }
  };

  // -----------------------------
  // 8️⃣ UI: name input or chat UI
  // -----------------------------
  return (
    <div className="chat-container">
      <h1>Real-time Chat (Socket.io)</h1>

      {!nameSubmitted ? (
        // Name input screen
        <div className="join-box">
          <input
            type="text"
            placeholder="Enter your name..."
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === "Enter") handleJoin();
            }}
          />
          <button onClick={handleJoin} disabled={!username.trim()}>
            Join Chat
          </button>
        </div>
      ) : (
        // Chat screen
        <div className="chat-box">
