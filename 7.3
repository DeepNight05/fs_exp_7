// -----------------------------
// 1️⃣ Import modules
// -----------------------------
const express = require("express");
const http = require("http");
const { Server } = require("socket.io");
const cors = require("cors");

// -----------------------------
// 2️⃣ Setup Express app and HTTP server
// -----------------------------
const app = express();
app.use(cors()); // allow cross-origin requests (for local dev)

const server = http.createServer(app);

// -----------------------------
// 3️⃣ Initialize Socket.io
// -----------------------------
// Allow connections from React dev server at http://localhost:3000
const io = new Server(server, {
  cors: {
    origin: "http://localhost:3000",
    methods: ["GET", "POST"],
  },
});

// -----------------------------
// 4️⃣ Basic route (optional)
// -----------------------------
app.get("/", (req, res) => {
  res.send({ status: "Socket.io server running" });
});

// -----------------------------
// 5️⃣ Socket.io connection handlers
// -----------------------------
io.on("connection", (socket) => {
  console.log(`User connected: ${socket.id}`);

  // When a client joins (sends their name)
  socket.on("join", (username) => {
    socket.username = username; // attach to socket instance
    // Broadcast to all other clients that someone joined
    socket.broadcast.emit("message", {
      user: "System",
      text: `${username} has joined the chat.`,
      time: new Date().toISOString(),
    });
  });

  // When a chat message is received from a client
  socket.on("sendMessage", (message, callback) => {
    const payload = {
      user: socket.username || "Anonymous",
      text: message,
      time: new Date().toISOString(),
    };
    // Broadcast to all clients (including sender)
    io.emit("message", payload);
    // Acknowledge receipt optionally
    if (callback) callback("Delivered");
  });

  // Handle disconnect
  socket.on("disconnect", () => {
    console.log(`User disconnected: ${socket.id}`);
    if (socket.username) {
      socket.broadcast.emit("message", {
        user: "System",
        text: `${socket.username} has left the chat.`,
        time: new Date().toISOString(),
      });
    }
  });
});

// -----------------------------
// 6️⃣ Start server
// -----------------------------
const PORT = process.env.PORT || 5000;
server.listen(PORT, () => {
  console.log(`✅ Server listening on port ${PORT}`);
});

// -----------------------------
